{
  "name": "@trustedrouter/ai-sdk-provider",
  "version": "0.1.0",
  "description": "TrustedRouter provider for the Vercel AI SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lore-Hex/trustedrouter-ai-sdk-provider.git"
  },
  "homepage": "https://trustedrouter.com",
  "keywords": [
    "ai",
    "ai-sdk",
    "trustedrouter",
    "llm",
    "openai-compatible",
    "vercel"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.0",
    "@ai-sdk/provider": "^2.0.0",
    "@ai-sdk/provider-utils": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
